#!/usr/bin/env python3
"""Pre-push gate. Installed by `python3 tests/hooks/install.py`.

Two checks, in cost order:

  syntax.py   local and instant -- blocks anything that cannot build
  a11y.py     axe-core over the DEPLOYED site

The accessibility scan is a gate rather than an advisory because this site
carries a legal obligation. It is skipped when the browser or engine is absent
(a fresh clone should not be unable to push), and when it runs it scans what is
currently deployed -- so it catches the previous push, not the one in hand. That
is a real limitation and the reason to run it directly before pushing anything
that touches markup.

SKIP with A11Y_SKIP=1 when the deployed site is mid-rebuild.
"""
import os
import pathlib
import subprocess
import sys

root = pathlib.Path(__file__).resolve().parent.parent.parent

print("pre-push: checking syntax")
rc = subprocess.run([sys.executable, str(root / "tests/syntax.py")], cwd=root).returncode
if rc:
    sys.exit(rc)

if os.environ.get("A11Y_SKIP"):
    print("pre-push: accessibility scan SKIPPED (A11Y_SKIP=1)")
    sys.exit(0)

print("pre-push: accessibility scan (axe-core)")
rc = subprocess.run([sys.executable, str(root / "tests/a11y.py")], cwd=root).returncode
if rc == 2:
    print("  axe-core or Playwright unavailable -- scan skipped, not failed")
    sys.exit(0)
sys.exit(rc)
